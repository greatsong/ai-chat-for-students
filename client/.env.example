# 클라이언트(프론트엔드) 환경변수
# 이 파일을 복사해서 client/.env 를 만든 뒤 값을 채우세요.
#   cp client/.env.example client/.env

# Google OAuth 클라이언트 ID (서버의 GOOGLE_CLIENT_ID 와 동일한 값)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# API 서버 주소 (선택)
# - 로컬 개발: 비워두면 Vite 프록시가 자동으로 localhost 백엔드로 연결됩니다.
# - Vercel + Railway 같이 별도 도메인 배포: 비워두고 vercel.json 의 rewrite 를 쓰는 방식을 권장합니다.
# VITE_API_URL=

# 평가 앱(proof-of-process) 주소 — "평가받기" 버튼이 대화를 넘길 대상
# 비워두면 프로덕션 기본값(https://pro-of-ai.vercel.app)을 사용합니다.
# VITE_EVALUATOR_URL=https://pro-of-ai.vercel.app
